{
  "expo": {
    "name": "hundo",
    "slug": "hundo",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/hundo-icon.png",
    "userInterfaceStyle": "light",
    "androidNavigationBar": { "backgroundColor": "#DFEBC2", "barStyle": "dark-content" },
    "splash": {
      "image": "./assets/hundo-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8FF79"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hundo.mobile"
    },
    "android": {
      "versionCode": 2,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/hundo-adaptive.png",
        "backgroundColor": "#E8FF79"
      },
      "package": "app.hundo.mobile"
    },
    "web": {
      "favicon": "./assets/hundo-icon.png"
    },
    "scheme": "hundo"
  }
}
